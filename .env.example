# Copy these into Vercel -> Project -> Settings -> Environment Variables.
# SERVER-ONLY: no VITE_ prefix, so they never reach the browser.

# --- required: access gate ---
GATE_SECRET=change-me-to-a-long-random-string
ADMIN_KEY=change-me-to-your-private-admin-password
CODE_PREFIX=EEE-

# --- required for the WhatsApp bot (see WHATSAPP-BOT-SETUP.md) ---
WHATSAPP_TOKEN=permanent-system-user-token-from-meta
WHATSAPP_PHONE_ID=your-whatsapp-phone-number-id
WHATSAPP_VERIFY_TOKEN=any-password-you-invent
SITE_URL=https://exam-prep-by-max.vercel.app
